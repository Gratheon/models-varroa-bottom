FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-server.txt .

RUN set -eux; \
    pip3 install --upgrade pip; \
    (pip3 install --index-url https://download.pytorch.org/whl/cpu torch torchvision || pip3 install torch torchvision); \
    pip3 install \
      flask \
      numpy \
      opencv-python-headless \
      pillow \
      psutil \
      pyyaml \
      requests \
      scipy; \
    pip3 install --no-deps ultralytics; \
    rm -rf /usr/local/lib/python*/site-packages/torch/include; \
    rm -rf /usr/local/lib/python*/site-packages/torch/test; \
    find /usr/local/lib/python*/site-packages -type d -name "__pycache__" -prune -exec rm -rf {} +; \
    rm -rf /root/.cache

COPY detect.py ./
COPY server_flask.py server.py
COPY model/ ./model/

EXPOSE 8750

CMD ["python3", "/app/server.py"]
